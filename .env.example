# The dashboard is a browser app: NEXT_PUBLIC_* values are visible to every visitor.
# So there are NO secrets here, only the public URL of the API.

# Where the browser reaches sentinel-api. It is baked in at BUILD time (see Dockerfile).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional same-origin mode (see docs/DEPLOY.md): the browser calls this app and it proxies /api/v1 to the API.
# Set NEXT_PUBLIC_API_URL=/ and API_PROXY_TARGET to the API's base URL, e.g. https://sentinel-api.onrender.com
# (build time; no path, no trailing slash needed).
# API_PROXY_TARGET=
# On Vercel only: lets the API trust the visitor's IP (same value as the API's PROXY_SHARED_SECRET, 32+ chars,
# read at runtime). See the API repo's docs/DEPLOY.md, "Client IPs".
# PROXY_SHARED_SECRET=

# Only for the Stitch MCP (design tooling): set as an environment secret, never commit it.
# STITCH_API_KEY=
